# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk route URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chart
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chart

# Clerk webhook signing secret (from Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=whsec_...

# Neon PostgreSQL — pooled URL for runtime, direct URL for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Render backend API (chart computation)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Resend (https://resend.com) — personal appraisal inquiry emails
RESEND_API_KEY=re_...
# Verified sender (use onboarding@resend.dev for testing; verify your domain for production)
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where inquiry notifications are delivered
INQUIRY_RECIPIENT_EMAIL=alphamac64@gmail.com

# Google Analytics 4 measurement ID (public — safe to commit a placeholder).
# Leave unset to disable GA4 entirely; the script only renders when present.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Cal.com booking webhook signing secret (Cal dashboard -> Webhooks).
# The webhook fails closed without this: unsigned payloads could forge bookings.
CAL_WEBHOOK_SECRET=

# Cal.com account the consultation event types live under.
NEXT_PUBLIC_CAL_USERNAME=alpha-mac-5tbxqf
