generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionStatus {
  free
  premium
  canceled
}

enum UserRole {
  user
  admin
}

enum AppLanguage {
  en
  hi
  ja
  ko
}

model User {
  id                  String               @id
  email               String               @unique
  name                String?
  subscriptionStatus  SubscriptionStatus   @default(free)
  role                UserRole             @default(user)
  appLanguage         AppLanguage?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  charts              SavedChart[]
  vedicCourseProgress VedicCourseProgress?
}

model VedicCourseProgress {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentChapter  Int      @default(0)
  completedSlides String[] @default([])
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

/// Computed-chart cache.
///
/// The ephemeris is deterministic: the same birth data and transit date always
/// produce the same chart, so recomputing it is pure waste. Matters more than a
/// normal cache would because the engine is a Render service that cold-starts
/// at ~30s — a cache hit is the difference between an instant chart and a
/// bounce.
///
/// `key` is a sha256 of the canonicalised ChartFormData. Rows are disposable;
/// `createdAt` drives TTL pruning since each payload is ~600 KB.
model ChartCache {
  key       String   @id
  chartData Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Server-side funnel log.
///
/// Mirrors the money events from `lib/analytics/events.ts`. Client analytics is
/// blockable and lossy, which is fine for engagement metrics but not for the
/// one number the business runs on — booked appraisals per 1,000 sessions.
/// `anonId` is the middleware cookie, so a conversion can be traced back across
/// the sign-in boundary to the landing page that produced it.
model FunnelEvent {
  id        String      @id @default(cuid())
  anonId    String
  userId    String?
  event     String
  props     Json?
  locale    AppLanguage
  path      String
  createdAt DateTime    @default(now())

  @@index([event, createdAt])
  @@index([anonId, createdAt])
  @@index([userId, createdAt])
}

model SavedChart {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String // person's name whose chart was generated
  locationName String
  formData     Json
  chartData    Json
  isSaved      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, isSaved])
}
